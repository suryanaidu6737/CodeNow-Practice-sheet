import java.util.*;
class Main{
    public static void main(String arg[]){
        Scanner sc = new Scanner(System.in);
         //write your code here
         int count=0;
         int n=sc.nextInt();
         for(int i=1;i<=n;i++){
            for(int j=i;i*j<=n;j++){
                 count++;
            }
         }
         System.out.print(count);
    }
}
